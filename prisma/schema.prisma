generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String     @id @default(cuid())
  name              String
  ghlAccessToken    String?
  ghlLocationId     String?
  ghlPipelineId     String?
  ghlStageMap       Json?      // { "NEW": "stageId1", "CONTACTED": "stageId2", ... }
  waPhoneNumberId   String?
  waAccessToken     String?
  defaultSequenceId String?
  masterPrompt      String?    @db.Text
  leads             Lead[]
  users             User[]
  sequences         Sequence[]
  templates         Template[]
  campaigns         Campaign[]
  lists             List[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model User {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  email           String       @unique
  passwordHash    String
  role            String       @default("ADMIN") // "ADMIN", "VIEWER"
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}

model Lead {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  ghlContactId     String?
  ghlOpportunityId String?
  firstName        String?
  lastName         String?
  email            String?
  phone            String?
  status           String       @default("NEW")
  tags             String[]     @default([])
  context          Json?
  messages         Message[]
  lastContactedAt  DateTime?
  lastInboundMessageAt DateTime? // Tracks start of 24h Meta window
  nextFollowupAt   DateTime?
  sequenceStep     Int          @default(0)
  sequenceActive   Boolean      @default(true)
  aiEnabled        Boolean      @default(true)
  sequenceId       String?
  sequence         Sequence?    @relation(fields: [sequenceId], references: [id])
  lists            List[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([phone])
  @@index([nextFollowupAt])
  @@index([status])
}

model Message {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id])
  content         String
  direction       String   // "INBOUND" or "OUTBOUND"
  type            String   @default("TEXT") // "TEXT", "TEMPLATE"
  aiGenerated     Boolean  @default(false)
  waMessageId     String?
  status          String?  // "DRAFT", "SENT", "DELIVERED", "READ", "FAILED"
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  createdAt       DateTime @default(now())

  @@index([leadId])
  @@index([campaignId])
}

model Template {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  content         String
  category        String?
  language        String       @default("es")
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}

model Sequence {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  name            String
  description     String?
  isActive        Boolean        @default(true)
  steps           SequenceStep[]
  leads           Lead[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
}

model SequenceStep {
  id              String   @id @default(cuid())
  sequenceId      String
  sequence        Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber      Int
  delayDays       Int      // Days to wait since previous step
  delayHours      Int      @default(0) // Hours to wait (can be combined with delayDays)
  messageTemplate String   // Text template or AI prompt
  useAI           Boolean  @default(true)
  isTemplate      Boolean  @default(false) // If true, forces sending as Meta Template
  createdAt       DateTime @default(now())

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
}

model Campaign {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  message         String       // Message content or AI prompt
  useAI           Boolean      @default(false)
  segment         Json?        // Filter criteria: { tags: [], statuses: [], excludeActive: true }
  status          String       @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  totalLeads      Int          @default(0)
  sentCount       Int          @default(0)
  batchSize       Int          @default(50)
  scheduledAt     DateTime?
  completedAt     DateTime?
  messages        Message[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

model List {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  leads          Lead[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
